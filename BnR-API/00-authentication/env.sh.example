# Copy to env.sh, fill in, then: source env.sh
# env.sh is git-ignored. Never commit real values.

export CONSOLE_API="https://cloudmanager.cloud.netapp.com"

# Long-lived refresh token from https://services.cloud.netapp.com/refresh-token (treat like a password)
export REFRESH_TOKEN="<refresh_token>"

export ACCOUNT_ID="<account_public_id>"       # a.k.a. Organization ID
export WORKSPACE_ID="<workspace_public_id>"   # shown as "Project" in the newer UI
export AGENT_ID="<console_agent_id>"
export AGENT_IP="<console_agent_ip>"
export AGENT_URL="https://${AGENT_IP}"

# ACCESS_TOKEN is created in 00-authentication/README.md (it expires; renew when API calls return 401)
