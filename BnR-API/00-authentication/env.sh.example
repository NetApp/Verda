# Copy to env.sh, fill in, then: source env.sh
# env.sh is git-ignored. Never commit real values.

export CONSOLE_API="https://cloudmanager.cloud.netapp.com"

# Long-lived refresh token from https://services.cloud.netapp.com/refresh-token (treat like a password)
export REFRESH_TOKEN="<refresh_token>"

export ACCOUNT_ID="<account_public_id>"       # a.k.a. Organization ID
export WORKSPACE_ID="<workspace_public_id>"   # shown as "Project" in the newer UI
export AGENT_ID="<console_agent_id>"
export AGENT_IP="<console_agent_ip>"
export AGENT_URL="https://${AGENT_IP}"

# Helper: exchange REFRESH_TOKEN for a new ACCESS_TOKEN.
# Run it again whenever API calls return 401 (the access token expires):  bnr_renew_token
# On failure ACCESS_TOKEN is left unset and the function returns 1. The token is never printed.
bnr_renew_token() {
  local token
  token=$(
    curl -s -X POST "https://netapp-cloud-account.auth0.com/oauth/token" \
      -H "Content-Type: application/json" \
      -d "{
        \"grant_type\": \"refresh_token\",
        \"refresh_token\": \"${REFRESH_TOKEN}\",
        \"client_id\": \"Mu0V1ywgYteI6w1MbD15fKfVIUrNXGWC\"
      }" | jq -r '.access_token // empty'
  )
  if [ -z "${token}" ]; then
    unset ACCESS_TOKEN
    echo "ERROR: could not get an access token. Check REFRESH_TOKEN (it may be wrong or expired) and your network." >&2
    return 1
  fi
  export ACCESS_TOKEN="${token}"
  echo "ACCESS_TOKEN: set (${#ACCESS_TOKEN} characters)"
}

bnr_renew_token || return 1

echo "CONSOLE_API  = ${CONSOLE_API}"
echo "ACCOUNT_ID   = ${ACCOUNT_ID}"
echo "WORKSPACE_ID = ${WORKSPACE_ID}"
echo "AGENT_ID     = ${AGENT_ID}"
echo "AGENT_IP     = ${AGENT_IP}"
echo "AGENT_URL    = ${AGENT_URL}"
